# .env.example
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM ────────────────────────────────────────────────────────────────────────
# Default model — fits comfortably in an 8 GB VRAM GPU (~3.5GB used).
# Pull it first:  ollama pull medgemma:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma:4b

# ── NCBI ───────────────────────────────────────────────────────────────────────
# REQUIRED by NCBI's terms of service — use your real email.
NCBI_EMAIL=your_email@example.com

# Optional but recommended — raises rate limit from 3 req/s to 10 req/s.
# Free, register at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ── Agent behavior ───────────────────────────────────────────────────────────────
# Below this cosine similarity score, the agent must consult PubMed
# before accepting an ontology mapping.
ONTOLOGY_CONFIDENCE_THRESHOLD=0.70

# Max ReAct loop iterations before giving up.
AGENT_MAX_STEPS=10

# LLM-assisted disambiguation for ambiguous jargon (e.g. "macs" = the MACS
# isolation METHOD vs. slang for "macrophages" CELL TYPE). Cost-gated: only
# fires when a raw embedding lookup already scored below threshold, so
# clean terms never pay the extra LLM round-trip. Set to false for max
# speed if your dataset's terms are already clean and unambiguous.
ENABLE_TERM_NORMALIZATION=true

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Batch size for building the ontology index. Tuned for 8 GB VRAM GPU.
# If you see "CUDA out of memory" during build_index.py, lower this to 256.
EMBED_BATCH_SIZE=512

# ── Storage paths (defaults are fine, override only if needed) ──────────────────
VECTOR_STORE_PATH=./data/vector_store
ONTOLOGY_DATA_PATH=./data/ontologies
